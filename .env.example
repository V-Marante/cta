# Local release configuration. Keep real values in an ignored .env file or shell.
SOURCE_DATABASE=extracted/cta.sqlite
RELEASE_IMAGE=registry.fly.io/your-app:YYYY-MM-DD-gitsha
CTA_GAME_VERSION=unknown
CTA_ASSETS_VERSION=unknown
# Optional source overrides used by scripts/prepare-release.sh.
HERO_ASSET_SOURCE=local/proprietary/hero-icons
UI_ASSET_SOURCE=local/proprietary/ui-icons
# Remote commands require explicit scripts/flags. Never store tokens here.
