# Local release configuration. Keep real values in an ignored .env file or shell.
PUBLIC_ARTIFACT_DIR=artifacts/public
PUBLIC_DATABASE=artifacts/public/cta.sqlite
RELEASE_IMAGE=cta-api:local
CTA_GAME_VERSION=unknown
CTA_ASSETS_VERSION=unknown
CTA_PORTRAIT_MODE=none
# Set to 1 only when the public-base-image build needs your normal Docker config.
CTA_USE_DOCKER_CONFIG=0
PRODUCTION_ORIGIN=https://www.example.com
ASSET_BASE_URL=https://assets.example.com
# Remote commands require explicit scripts/flags. Never store tokens here.
